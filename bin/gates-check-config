#!/usr/bin/env bash
# gates-check-config: the checks that must read THIS repository's real state (its gates.conf, lists, stubs and pin), kept apart from the package's hermetic tests, which never do. Run it IN the consumer, in Tier 1
# (the package's own repository is a consumer of itself). Prints `ran: gates-check-config: N cases`; every problem is listed, then exit 1.
#  1. gates.conf is readable (an unknown key fails); every path it names exists (a typo is a silent hole).
#  2. the protected list covers the classes that must wait for the owner: the tier1 script, the gates configuration, the lander's configuration, entry script and hooks, the pins, the signers, the workflows,
#     the visibility marker and the list itself (a class dropped from the list fails here).
#  3. the lander's stubs are the package's stub and its hooks call the judge and the suite (core/relabel-attacks.sh --check-wired); the pinned lander and gates are intact (land-check).
#  4. no hand copy: a file the pin delivers (by name, under core/ or lean/) is not also tracked elsewhere outside scripts/gates/.
set -euo pipefail
export LC_ALL=C
here=$(cd "$(dirname "$0")/.." && pwd); . "$here/core/lib-ran.sh"; . "$here/core/gates-conf.sh"
cd "$(git rev-parse --show-toplevel)"; bad=0
problem() { echo "gates-check-config: $*" >&2; bad=1; }
gates_load || { echo "gates-check-config: gates.conf cannot be read (above)" >&2; exit 1; }; ran_case
tracked=$(git ls-files)
for p in $GATES_TIER1 $GATES_PROTECTED_LIST $GATES_RULES_FILE $GATES_STRICT $GATES_LISTS $GATES_SOURCE; do grep -qxF -- "$p" <<<"$tracked" || problem "gates.conf names $p, which is not a tracked file"; done; ran_case
for d in $GATES_SOURCE_DIRS; do grep -q "^$d" <<<"$tracked" || problem "gates.conf names the directory $d, which holds no tracked file"; done; ran_case
{ printf '%s\n' "$GATES_TIER1" scripts/gates.conf scripts/land.conf scripts/land-direct scripts/land/PIN scripts/land.signers "$GATES_PROTECTED_LIST" .github/visibility; [ -e scripts/gates/PIN ] && printf '%s\n' scripts/gates/PIN scripts/gates.signers
  grep -E '^(scripts/land\.d/|\.github/workflows/)' <<<"$tracked" || true; } > "${TMPDIR:-/tmp}/gcc.required.$$"
trap 'rm -f "${TMPDIR:-/tmp}/gcc.required.$$" "${TMPDIR:-/tmp}/gcc.list.$$"' EXIT
cp "$GATES_PROTECTED_LIST" "${TMPDIR:-/tmp}/gcc.list.$$"
dropped=$("$here/core/protected-set.sh" --superset "${TMPDIR:-/tmp}/gcc.required.$$" "${TMPDIR:-/tmp}/gcc.list.$$" 2>&1) || problem "the protected list does not cover: $(echo $dropped)"; ran_case
if [ -e scripts/gates/PIN ]; then g=scripts/gates; else g=.; fi
"$here/core/relabel-attacks.sh" --check-wired --tree . 2>&1 >/dev/null || problem "the lander's stubs or hooks are not wired (relabel-attacks.sh --check-wired, above)"; ran_case
[ ! -x scripts/land/bin/land-check ] || scripts/land/bin/land-check >/dev/null 2>&1 || problem "the pinned copies are not intact (scripts/land/bin/land-check)"; ran_case
if [ "$g" != . ]; then
  for f in $(awk '{print $2}' scripts/gates/MANIFEST.sha256 | grep -E '^(core|lean)/'); do b=${f##*/}
    hit=$(grep -E "(^|/)$b\$" <<<"$tracked" | grep -v '^scripts/gates/' || true); [ -z "$hit" ] || problem "a hand copy of the pinned $b: $(echo $hit)"; done; ran_case
fi
[ "$bad" = 0 ] || exit 1
ran_done gates-check-config
