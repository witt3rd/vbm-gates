#!/usr/bin/env bash
# On the rebased, regenerated tree (run from main's copy by the stub). (1) The protected set (core/protected-set.sh): touching it is allowed, every gate must pass; printed for the record.
# (2) The gate-diff judge (core/gate-diff-improving.sh --suite-judged): a baseline may only improve, the tier1 script only gains plain steps, a removed or changed line needs an exact-diff approval the judge
# recomputes, the protected list only grows; a list or gate-source change is judged by the relabel-attack suite (post-tier1). A refusal is exit 12: nothing lands.
set -euo pipefail
core=$(cd "$(dirname "$0")/../core" && pwd)
. "$core/gates-conf.sh"
gates_load || { echo "land.d/post-rebase: gates.conf cannot be read (above); cannot decide, not landing." >&2; exit 12; }
rc=0; prot=$("$core/protected-set.sh" --list "$GATES_PROTECTED_LIST" "$LAND_BASE_REF" HEAD 2>/dev/null) || rc=$?
case $rc in 0) echo "land.d/post-rebase: protected set: none touched";; 1) echo "land.d/post-rebase: protected set: TOUCHED ($(echo $prot)): allowed, every gate must pass";; *) echo "land.d/post-rebase: protected set: could not be decided";; esac
rc=0; out=$("$core/gate-diff-improving.sh" --suite-judged "$LAND_BASE_REF" HEAD 2>&1) || rc=$?
if [ "$rc" != 0 ]; then printf '%s\n' "$out" | tail -8 >&2; echo "land.d/post-rebase: the gate-defining files of your commits are not purely improving (gate-diff-improving: exit $rc); not landing." >&2; exit 12; fi
